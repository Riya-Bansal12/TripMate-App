# ==============================================================================
# TripMate Environment Configuration Template (.env.example)
# NEVER commit real API keys, tokens, or credentials to this file or Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BROWSER-VISIBLE BUILD-TIME CONFIGURATION (Client / Vite)
# ------------------------------------------------------------------------------
# No paid frontend map keys required: TripMate uses Leaflet + OpenStreetMap
# standard tiles and Komoot Photon geocoding with zero API keys or billing.

# ------------------------------------------------------------------------------
# 2. CLOUD RUN RUNTIME ENVIRONMENT VARIABLES (Non-Secret Server Config)
# ------------------------------------------------------------------------------
# NODE_ENV: Set to "production" on Cloud Run so Express serves dist/ and skips Vite dev middleware.
NODE_ENV="production"

# PORT: HTTP listening port. Cloud Run injects PORT=8080 automatically; local dev defaults to 3000.
PORT="8080"

# APP_URL: Public base URL of the deployed application (for reference / links).
APP_URL="https://tripmate-example.asia-south1.run.app"

# GEMINI_MODEL: Optional server-side Gemini model ID override (defaults to gemini-4-hydrogen).
GEMINI_MODEL="gemini-4-hydrogen"

# ------------------------------------------------------------------------------
# 3. GOOGLE CLOUD SECRET MANAGER SECRETS (Server-Only — NEVER VITE_ PREFIXED)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY:
# Required for server-side @google/genai calls across /api/ai/*.
# In AI Studio: configure via Settings > Secrets.
# On Cloud Run: mount via Google Cloud Secret Manager (--set-secrets=GEMINI_API_KEY=...).
# NEVER prefix with VITE_ or expose in frontend bundles, HTML, or logs.
GEMINI_API_KEY="YOUR_SERVER_ONLY_GEMINI_API_KEY"
